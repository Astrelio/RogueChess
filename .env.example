DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=8787
# Firebase Admin (JSON string o ruta). Para local puedes omitir y usar VERIFY_SKIP=true SOLO en dev.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Solo desarrollo local sin Admin SDK (NUNCA en producción)
VERIFY_SKIP=false
# Portal (useportal.co) — realtime
PORTAL_PUBLIC_KEY=
PORTAL_SECRET_KEY=

# Frontend (Vite) — copiar a .env.local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_PROXY=http://localhost:8787
VITE_PORTAL_PUBLIC_KEY=
