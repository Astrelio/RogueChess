{
  "name": "roguechess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev\" \"npm run dev:api\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "portal:deploy": "portal deploy",
    "db:patch:phase2": "node scripts/apply-sql.mjs db/patch_phase2_shop_fixes.sql",
    "db:patch:engine": "node scripts/apply-sql.mjs db/patch_phase2_engine.sql",
    "db:patch:joker-ply": "node scripts/apply-sql.mjs db/patch_phase2_joker_ply.sql",
    "db:patch:giratiempo": "node scripts/apply-sql.mjs db/patch_phase2_giratiempo.sql",
    "db:patch:clocks": "node scripts/apply-sql.mjs db/patch_phase2_clocks.sql",
    "test": "tsx --test server/engine/engine.test.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@neondatabase/serverless": "^1.0.1",
    "@portalsdk/core": "^0.1.5",
    "@portalsdk/extension-protocol": "^0.1.0",
    "@portalsdk/react": "^0.1.4",
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "framer-motion": "^12.6.3",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-chessboard": "^5.12.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "^3.1.0",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@portalsdk/cli": "^0.5.5",
    "@portalsdk/config": "^0.2.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
